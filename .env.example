# Production Control Hub gateway configuration.
# Copy to .env in the repository root and adjust. Real environment variables override this file.
# Never commit .env — it can contain the bootstrap admin password.

# Network binding. Default is loopback (this computer only).
# For iPads/laptops on the production LAN, set this to the gateway's LAN address
# (recommended, e.g. 192.168.10.5) or 0.0.0.0 for all interfaces.
PCH_HOST=127.0.0.1
PCH_PORT=8420

# Where the SQLite database lives.
PCH_DATA_DIR=./data

# HTTPS (recommended for iPad: enables wake lock and the offline app shell).
# Generate with scripts/gen-cert.sh (see docs/INSTALL.md).
# PCH_TLS_CERT=./certs/pch.crt
# PCH_TLS_KEY=./certs/pch.key

# Extra allowed browser origins, comma separated. Same-origin is always allowed.
# Only needed behind a reverse proxy or alternate hostname.
# PCH_ALLOWED_ORIGINS=https://control.local:8420

# Session lifetime (sliding), in hours.
PCH_SESSION_TTL_HOURS=12

# Refuse clients from non-private (internet) addresses. Leave false.
PCH_ALLOW_NON_PRIVATE_CLIENTS=false

# Record each key press in the activity log.
PCH_AUDIT_PRESSES=true
PCH_AUDIT_RETENTION_DAYS=90

PCH_LOG_LEVEL=info

# Optional: initial Companion connection (used only on first start; later changes are made in Settings).
# PCH_COMPANION_HOST=192.168.10.20
# PCH_COMPANION_PORT=16622
# PCH_COMPANION_TRANSPORT=tcp

# Optional: create the first admin unattended. Otherwise the gateway prints a one-time setup code.
# PCH_ADMIN_USERNAME=admin
# PCH_ADMIN_PASSWORD=change-me-to-something-long
